# Copia como .env. En producción reemplaza credenciales y secretos por valores privados.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
JWT_KEY=FunkoApi-Development-Only-Key-32-Bytes!

# Origen permitido por CORS en el backend de Compose (Production).
CORS_ALLOWED_ORIGIN_0=http://localhost:5197

# Administrador que se aprovisiona al arrancar en Production.
BOOTSTRAP_ADMIN_EMAIL=admin@admin.com
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=Sistema

# SMTP de desarrollo (Mailpit en el host: localhost:1025, sin TLS).
# Si el backend se ejecuta dentro de Compose, usa SMTP_HOST=mailpit con --profile development.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_USERNAME=dev
SMTP_PASSWORD=dev
SMTP_FROM=noreply@funkos.com
