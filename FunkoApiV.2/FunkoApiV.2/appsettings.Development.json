{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=funkos;Username=postgres;Password=postgres",
    "Postgre": "Host=localhost;Port=5432;Database=funkos;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Cache": {
    "Name": "Redis",
    "ExpiryMinutes": 30,
    "SlidingExpirationMinutes": 60,
    "Redis": "localhost:6379"
  },
  "Mongo": {
    "Connection": "mongodb://localhost:27017",
    "Database": "funko"
  },
  "Storage": {
    "UploadPath": "wwwroot/uploads",
    "MaxFileSize": 5242880,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "AllowedContentTypes": ["image/jpeg", "image/jpeg", "image/png", "image/webp"]
  },
  "Jwt": {
    "Key": "FunkoApi-Development-Only-Key-32-Bytes!",
    "Issuer": "FunkoApi",
    "Audience": "FunkoApi",
    "ExpirationMin": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cassandra": {
    "Hosts": [ "127.0.0.1" ],
    "Port": 9043,
    "Keyspace": "funkos"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "From": "noreply@funkos.com",
    "DisplayName": "FunkoApi (desarrollo)"
  }
}
