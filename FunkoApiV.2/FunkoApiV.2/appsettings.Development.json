{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/funko-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "ApiSettings": {
    "Name": "Development"
  },
  "Repository": {
    "Name": "SQLite"
  },
  "Cache": {
    "Name": "MemCache",
    "ExpiryMinutes": 30,
    "SlidingExpirationMinutes": 10
  }
}