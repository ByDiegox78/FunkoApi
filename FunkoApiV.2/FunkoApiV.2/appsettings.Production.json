{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore": "Error"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/funko-.log",
                    "rollingInterval": "Day"
                }
            }
        ],
        "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
    },
    "ApiSettings": {
        "Name": "Production"
    },
    "Repository": {
        "Name": "Postgre",
        "ConnectionString": "Host=db;Port=5432;Database=funkos;Username=postgres;Password=postgres"
    },
    "Cache": {
        "Name": "Redis",
        "ExpiryMinutes": 30,
        "SlidingExpirationMinutes": 10
    },
    "ConnectionStrings": {
        "Redis": "redis:6379"
    }
}