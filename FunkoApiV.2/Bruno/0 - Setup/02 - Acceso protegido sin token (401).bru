meta {
  name: Acceso a proveedores sin token
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/Proveedor
  body: none
  auth: none
}

tests {
  test("status 401 sin token", function() {
    expect(res.status).to.equal(401);
  });
  test("el endpoint exige autenticacion", function() {
    expect(res.headers["www-authenticate"]).to.include("Bearer");
  });
}
