meta {
  name: Iniciar sesion como admin
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

script:pre-request {
  const email = bru.getProcessEnv("FUNKO_ADMIN_EMAIL");
  const password = bru.getProcessEnv("FUNKO_ADMIN_PASSWORD");
  if (!email || !password) {
    throw new Error("Define FUNKO_ADMIN_EMAIL y FUNKO_ADMIN_PASSWORD para ejecutar Bruno.");
  }
  bru.setVar("adminEmail", email);
  bru.setVar("adminPassword", password);
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.role === "ADMIN" && res.body.token) {
    bru.setEnvVar("adminToken", res.body.token);
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("el usuario tiene rol ADMIN", function() {
    expect(res.body.role).to.equal("ADMIN");
  });
  test("devuelve token", function() {
    expect(res.body.token).to.be.a("string").and.not.empty;
  });
}
