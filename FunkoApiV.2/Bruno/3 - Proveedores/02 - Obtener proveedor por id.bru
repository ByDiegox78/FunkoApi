meta {
  name: Obtener proveedor por id (MongoDB)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/Proveedor/{{proveedorIdCreado}}
  body: none
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de consultar proveedores.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("id coincide", function() {
    expect(res.body.id).to.equal(bru.getEnvVar("proveedorIdCreado"));
  });
  test("tiene nombre y direccion", function() {
    expect(res.body.nombre).to.be.a("string");
    expect(res.body.direccion).to.be.a("string");
  });
}
