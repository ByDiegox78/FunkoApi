meta {
  name: Actualizar proveedor (MongoDB)
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/Proveedor/{{proveedorIdCreado}}
  body: json
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de actualizar proveedores.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

body:json {
  {
    "nombre": "Prov Bruno Updated",
    "direccion": "Calle Bruno 2"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("nombre actualizado", function() {
    expect(res.body.nombre).to.equal("Prov Bruno Updated");
  });
  test("direccion actualizada", function() {
    expect(res.body.direccion).to.equal("Calle Bruno 2");
  });
}
