meta {
  name: Listar proveedores (MongoDB)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/Proveedor
  body: none
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de consultar proveedores.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("respuesta es array", function() {
    expect(res.body).to.be.an("array");
  });
}
