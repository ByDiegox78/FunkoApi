meta {
  name: Crear proveedor invalido (400)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/Proveedor
  body: json
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de crear proveedores.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

body:json {
  {
    "nombre": "",
    "direccion": ""
  }
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });
  test("cuerpo tiene mensaje", function() {
    expect(res.body.message).to.be.a("string");
  });
}
