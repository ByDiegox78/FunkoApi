meta {
  name: Eliminar categoria con funkos (409)
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/categorias/{{categoriaId}}
  body: none
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de eliminar categorías.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });
  test("mensaje menciona funkos", function() {
    expect(res.body.message).to.include("funko");
  });
}
