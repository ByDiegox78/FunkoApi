meta {
  name: Eliminar categoria inexistente (404)
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/api/categorias/NoExiste001
  body: none
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de eliminar categorías.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
}
