meta {
  name: Actualizar categoria creada
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/categorias/{{categoriaIdCreada}}
  body: json
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de actualizar categorías.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

body:json {
  {
    "nombre": "Categoria Bruno Actualizada",
    "descripcion": "Descripcion actualizada por Bruno"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("categoriaIdActualizada", res.body.id);
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("nombre actualizado", function() {
    expect(res.body.nombre).to.equal("Categoria Bruno Actualizada");
  });
  test("descripcion actualizada", function() {
    expect(res.body.descripcion).to.equal("Descripcion actualizada por Bruno");
  });
}
