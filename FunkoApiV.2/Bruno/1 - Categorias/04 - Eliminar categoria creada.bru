meta {
  name: Eliminar categoria creada
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/categorias/{{categoriaIdCreada}}
  body: none
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de eliminar categorías.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

tests {
  test("status 204", function() {
    expect(res.status).to.equal(204);
  });
}
