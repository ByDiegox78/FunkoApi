meta {
  name: Actualizar categoria invalida (400)
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/categorias/{{categoriaId}}
  body: json
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de actualizar categorías.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

body:json {
  {
    "nombre": "",
    "descripcion": "Sin nombre"
  }
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });
  test("cuerpo tiene mensaje", function() {
    expect(res.body.message).to.be.a("string");
  });
}
