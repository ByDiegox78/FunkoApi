meta {
  name: Obtener funko por id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/funkos/{{funkoId}}
  body: none
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de consultar por ID.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("id coincide", function() {
    expect(res.body.id).to.equal(parseInt(bru.getEnvVar("funkoId")));
  });
  test("tiene nombre y precio", function() {
    expect(res.body.name).to.be.a("string");
    expect(res.body.precio).to.be.a("number");
  });
}
