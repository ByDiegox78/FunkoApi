meta {
  name: Actualizar funko inexistente (404)
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/funkos/99999
  body: json
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de actualizar funkos.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

body:json {
  {
    "name": "No existe",
    "precio": 10,
    "categoriaId": "VQGCKyvzIM4",
    "proveedorId": "{{proveedorIdCreado}}",
    "stock": 1,
    "imagen": "/uploads/funkos/test.png"
  }
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
  test("cuerpo tiene mensaje", function() {
    expect(res.body.message).to.be.a("string");
  });
}
