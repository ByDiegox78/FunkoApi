meta {
  name: Crear funko
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/funkos
  body: json
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de crear funkos.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

body:json {
  {
    "name": "Funko Bruno Test",
    "precio": 15.99,
    "categoriaId": "{{categoriaId}}",
    "proveedorId": "{{proveedorIdCreado}}",
    "stock": 5,
    "imagen": "/uploads/funkos/placeholder.png"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("funkoIdCreado", res.body.id);
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("devuelve id", function() {
    expect(res.body.id).to.be.a("number");
  });
  test("categoria correcta", function() {
    expect(res.body.categoriaId).to.equal(bru.getEnvVar("categoriaId"));
  });
  test("imagen relativa", function() {
    expect(res.body.imagen).to.include("/uploads/funkos/");
  });
}
