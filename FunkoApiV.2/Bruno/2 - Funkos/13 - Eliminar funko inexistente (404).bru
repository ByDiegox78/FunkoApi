meta {
  name: Eliminar funko inexistente (404)
  type: http
  seq: 13
}

delete {
  url: {{baseUrl}}/api/funkos/99999
  body: none
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesión como ADMIN antes de eliminar funkos.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
}
