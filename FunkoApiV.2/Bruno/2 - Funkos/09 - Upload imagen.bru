meta {
  name: Subir imagen sin archivo (400)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/funkos/imagen
  body: none
  auth: none
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) throw new Error("Inicia sesion como ADMIN antes de subir imagenes.");
  req.setHeader("Authorization", `Bearer ${token}`);
}

tests {
  test("status 400 por archivo ausente", function() {
    expect(res.status).to.equal(400);
  });
  test("cuerpo tiene mensaje o ruta", function() {
    expect(res.body).to.be.an("object");
  });
}
